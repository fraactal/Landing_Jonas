output "lead_api_function_url" {
  description = "Public Lambda Function URL for the lead API. Do not treat this URL as a secret."
  value       = aws_lambda_function_url.lead_api.function_url
}

output "leads_table_name" {
  description = "DynamoDB table used to persist leads."
  value       = aws_dynamodb_table.leads.name
}

output "ses_identity_domain" {
  description = "SES domain identity for lead notification sending."
  value       = aws_ses_domain_identity.lead_notifications.domain
}

output "ses_domain_verification_token" {
  description = "SES domain verification token. Publish the corresponding TXT record in Cloudflare in a controlled DNS step."
  value       = aws_ses_domain_identity.lead_notifications.verification_token
}

output "ses_dkim_tokens" {
  description = "DKIM tokens generated by SES. Publish each token as a CNAME in Cloudflare in a controlled DNS step."
  value       = aws_ses_domain_dkim.lead_notifications.dkim_tokens
}

output "ses_dkim_cname_records" {
  description = "Convenience view of DKIM CNAME records to create later in Cloudflare."
  value = [
    for token in aws_ses_domain_dkim.lead_notifications.dkim_tokens : {
      name  = "${token}._domainkey.${aws_ses_domain_identity.lead_notifications.domain}"
      type  = "CNAME"
      value = "${token}.dkim.amazonses.com"
    }
  ]
}
output "booking_api_function_url" {
  description = "Public Lambda Function URL for the booking API. Do not treat this URL as a secret."
  value       = aws_lambda_function_url.booking_api.function_url
}